{
  "name": "ephemeral-monorepo",
  "private": true,
  "packageManager": "pnpm@11.28.6+sha512.55d90390c3b39042f1505a2697789f0256c6d95bb28bdd7cb731af1887c9f2629ef581acb9f4e4ec772024c8203c2aed22a03299b97103fdcf32668e905d0024",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.9"
  },
  "scripts": {
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "format": "prettier --write . && pnpm -C apps/api format",
    "format:check": "prettier --check . && pnpm -C apps/api format:check",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "check": "pnpm format:check && turbo lint typecheck test",
    "verify": "pnpm check && pnpm test:e2e:fast",
    "test:e2e": "playwright test",
    "test:e2e:fast": "playwright test --project=chromium",
    "test:e2e:dev": "playwright test --config playwright.dev.config.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "clean": "turbo clean"
  }
}
